FROM python:3.12-slim-bookworm
ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 \
    PIXGUARD_DATA_DIR=/data/pixguard
RUN apt-get update && apt-get install -y --no-install-recommends openjdk-17-jre-headless procps && \
    rm -rf /var/lib/apt/lists/* && pip install --no-cache-dir poetry==2.2.1
WORKDIR /app
COPY pyproject.toml poetry.lock ./
RUN poetry config virtualenvs.create false && poetry install --only main,pipeline,test --no-root
COPY src ./src
COPY tests ./tests
RUN poetry install --only-root && groupadd --gid 10001 pixguard && \
    useradd --uid 10001 --gid pixguard --no-create-home pixguard && \
    mkdir -p /data/pixguard && chown -R pixguard:pixguard /data/pixguard /app
USER pixguard
CMD ["pixguard-pipeline", "--help"]
